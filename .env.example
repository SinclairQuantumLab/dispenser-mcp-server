# Operator-only startup configuration. Do not commit a populated .env file.
# Omit for backward-compatible stdio, or select reviewed loopback HTTP deployment.
DISPENSER_MCP_TRANSPORT=stdio
# DISPENSER_MCP_HTTP_BIND_HOST=127.0.0.1
# DISPENSER_MCP_HTTP_PORT=8000
# DISPENSER_MCP_HTTP_PATH=/mcp
# DISPENSER_MCP_HTTP_TRUST_MODE=loopback_only
# Reverse-proxy mode only; exact values, no wildcard:
# DISPENSER_MCP_HTTP_ALLOWED_HOSTS=mcp.example.invalid
# DISPENSER_MCP_HTTP_ALLOWED_ORIGINS=https://console.example.invalid

# Optional in this development checkout; defaults to the vendored canonical file.
DISPENSER_HICUBE_CLIENT_FILE=C:\path\to\mcp-server\dependencies\hicube\hicube_neo_client.py
DISPENSER_HICUBE_HOST=replace-with-device-host
DISPENSER_HICUBE_PORT=4840
DISPENSER_HICUBE_TIMEOUT_S=5.0

# Canonical pinned Git submodule source for the semantic Siglent driver.
DISPENSER_SIGLENT_DRIVER_SRC=C:\path\to\mcp-server\dependencies\py-siglent-spd3000\src
# Operator-only gateway endpoint and local untracked authentication file.
DISPENSER_SIGLENT_CONNECTION=gateway
DISPENSER_SIGLENT_IDENTIFIER=replace-with-configured-resource
# Optional in this development checkout; defaults to the canonical settings path.
DISPENSER_SIGLENT_GATEWAY_AUTH_FILE=C:\path\to\mcp-server\settings\py-siglent-spd3000-gateway-auth.toml
DISPENSER_SIGLENT_TIMEOUT_S=5.0
DISPENSER_SIGLENT_MIN_COMMAND_INTERVAL_MS=100.0

# Required immutable safety policy. Example values are placeholders only.
DISPENSER_SIGLENT_ACCEPTANCE_CONTEXT=production_dispenser
# Required only for unloaded_hil. The MCP process manages pending/completed/trip
# state here but has no reset/delete surface. Protect its directory from the agent.
# DISPENSER_SIGLENT_UNLOADED_HIL_STATE_FILE=C:\protected\unloaded-hil-state.json
DISPENSER_SIGLENT_TOPOLOGY=parallel_ch1
DISPENSER_SIGLENT_CHANNEL=CH1
DISPENSER_SIGLENT_EXPECTED_MODEL=SPD3303X
DISPENSER_SIGLENT_EXPECTED_SERIAL_NUMBER=replace-with-verified-serial
DISPENSER_SIGLENT_COMPLIANCE_VOLTAGE_V=replace-with-approved-voltage
DISPENSER_SIGLENT_MAX_LOAD_CURRENT_A=4.8
DISPENSER_SIGLENT_UPWARD_STEP_A=0.2
DISPENSER_SIGLENT_CONTROL_ENABLED=false
