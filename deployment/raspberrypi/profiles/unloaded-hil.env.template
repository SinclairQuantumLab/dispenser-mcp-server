# Copy to /etc/dispenser-conditioning-mcp/unloaded-hil/profile.env as root.
DISPENSER_MCP_TRANSPORT=streamable-http
DISPENSER_MCP_HTTP_BIND_HOST=127.0.0.1
DISPENSER_MCP_HTTP_PORT=8001
DISPENSER_MCP_HTTP_PATH=/mcp
DISPENSER_MCP_HTTP_TRUST_MODE=authenticated_ssh_tunnel
DISPENSER_PYTHON_RUNTIME_MANIFEST_SHA256=replace-with-approved-runtime-manifest-sha256
DISPENSER_HICUBE_CLIENT_FILE=/opt/dispenser-conditioning-mcp/dependencies/hicube/hicube_neo_client.py
DISPENSER_HICUBE_HOST=replace-with-device-host
DISPENSER_HICUBE_PORT=4840
DISPENSER_HICUBE_TIMEOUT_S=5.0
DISPENSER_SIGLENT_DRIVER_SRC=/opt/dispenser-conditioning-mcp/dependencies/py-siglent-spd3000/src
DISPENSER_SIGLENT_CONNECTION=gateway
DISPENSER_SIGLENT_IDENTIFIER=replace-with-gateway-resource
DISPENSER_SIGLENT_GATEWAY_AUTH_FILE=/etc/dispenser-conditioning-mcp/unloaded-hil/gateway-auth.toml
DISPENSER_SIGLENT_TIMEOUT_S=5.0
DISPENSER_SIGLENT_MIN_COMMAND_INTERVAL_MS=100.0
DISPENSER_SIGLENT_ACCEPTANCE_CONTEXT=unloaded_hil
DISPENSER_SIGLENT_UNLOADED_HIL_STATE_FILE=/var/lib/dispenser-conditioning-mcp/unloaded-hil/operation-state.json
DISPENSER_SIGLENT_TOPOLOGY=parallel_ch1
DISPENSER_SIGLENT_CHANNEL=CH1
DISPENSER_SIGLENT_EXPECTED_MODEL=replace-with-verified-model
DISPENSER_SIGLENT_EXPECTED_SERIAL_NUMBER=replace-with-verified-serial
DISPENSER_SIGLENT_COMPLIANCE_VOLTAGE_V=replace-with-operator-approved-voltage
DISPENSER_SIGLENT_MAX_LOAD_CURRENT_A=4.8
DISPENSER_SIGLENT_UPWARD_STEP_A=0.2
DISPENSER_SIGLENT_CONTROL_ENABLED=false
