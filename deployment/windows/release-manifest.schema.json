{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dispenser-conditioning/release-manifest.schema.json",
  "title": "Dispenser Conditioning MCP Windows Python Payload Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "target",
    "dependency_lock",
    "runtime_inventory",
    "mcp_wheel",
    "wheelhouse"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "dispenser_mcp_windows_python_payload"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "machine", "python_major", "python_minor"],
      "properties": {
        "platform": {"const": "win32"},
        "machine": {"const": "AMD64"},
        "python_major": {"const": 3},
        "python_minor": {"const": 13}
      }
    },
    "dependency_lock": {"$ref": "#/$defs/artifact"},
    "runtime_inventory": {"$ref": "#/$defs/artifact"},
    "mcp_wheel": {"$ref": "#/$defs/artifact"},
    "wheelhouse": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/wheel"}
    }
  },
  "$defs": {
    "leaf": {"type": "string", "pattern": "^[^/\\\\]+$", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {"$ref": "#/$defs/leaf"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "wheel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "distribution", "version", "sha256"],
      "properties": {
        "file": {"$ref": "#/$defs/leaf"},
        "distribution": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
