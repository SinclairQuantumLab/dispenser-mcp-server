# Hardware backend only; copy to gateway-auth.toml. Simulation does not read this file.
# Optional shared token: uncomment and replace only when the gateway requires authentication.
# This file must exist. Commented/missing token or blank token means no token; the gateway decides whether to accept it.
# Upstream py-siglent-spd3000 owns this format; do not add other keys.
# Keep the populated file untracked and do not show its contents to an agent or in logs.
# token = "<TOKEN>"
