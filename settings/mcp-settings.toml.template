# MCP process and deployment-specific safety settings.
backend = "real"
# Replace `<ACCEPTANCE_CONTEXT>` with "production_dispenser" or "unloaded_hil".
acceptance_context = "<ACCEPTANCE_CONTEXT>"
# Replace `<SERIAL_NUMBER>` with the verified serial number of the power supply.
expected_serial_number = "<SERIAL_NUMBER>"
# Replace the quoted `<COMPLIANCE_VOLTAGE_V>` with the approved numeric voltage, without quotes.
compliance_voltage_v = "<COMPLIANCE_VOLTAGE_V>"
control_enabled = false
allow_remote_access = false
port = 8000

# Required only when acceptance_context = "unloaded_hil". The operator must
# initialize and protect this state file outside the MCP process.
# unloaded_hil_state_file = "/absolute/protected/unloaded-hil-state.json"

# Streamable HTTP is always served at /mcp. Set allow_remote_access = true
# to listen on all IPv4 interfaces for direct connections to this host.
